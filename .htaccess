# Garante que crawlers de redes sociais consigam acessar o site para gerar prévias de link
<IfModule mod_setenvif.c>
  SetEnvIfNoCase User-Agent "facebookexternalhit" allow_bot
  SetEnvIfNoCase User-Agent "Facebot" allow_bot
  SetEnvIfNoCase User-Agent "WhatsApp" allow_bot
  SetEnvIfNoCase User-Agent "Twitterbot" allow_bot
  SetEnvIfNoCase User-Agent "LinkedInBot" allow_bot
  SetEnvIfNoCase User-Agent "TelegramBot" allow_bot
  SetEnvIfNoCase User-Agent "Slackbot" allow_bot
  SetEnvIfNoCase User-Agent "Discordbot" allow_bot
</IfModule>

<IfModule mod_authz_core.c>
  <RequireAny>
    Require all granted
    Require env allow_bot
  </RequireAny>
</IfModule>

# Anti-clickjacking: nenhuma página do site pode ser exibida em iframe de outro domínio
# (painel, admin e perfis logados têm ações de dois cliques: botão + confirmar)
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
</IfModule>

# Portal de professores: /professores/p/<slug> serve o perfil (o JS lê o slug da URL)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^professores/p/([a-z0-9-]+)/?$ professores/perfil.html [L]
</IfModule>
